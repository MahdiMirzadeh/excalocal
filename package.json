    "self-hosted"
  ],
  "author": "Mahdi Mirzadeh <mahdi@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MahdiMirzadeh/excalocal.git"
  },
  "bugs": {
    "url": "https://github.com/MahdiMirzadeh/excalocal/issues"
  },
  "homepage": "https://github.com/MahdiMirzadeh/excalocal#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@excalidraw/excalidraw": "0.17.6"
